<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <JellyfinTargetFramework Condition="'$(JellyfinTargetFramework)' == ''">net10.0</JellyfinTargetFramework>
    <TargetFramework>$(JellyfinTargetFramework)</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.AnimeFiller</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.AnimeFiller</RootNamespace>
    <PluginVersion Condition="'$(PluginVersion)' == ''">1.1.0.0</PluginVersion>
    <Version>$(PluginVersion)</Version>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- HTML parser for animefillerlist.com -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
  </ItemGroup>

</Project>
